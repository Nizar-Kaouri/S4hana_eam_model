// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Notification Cause - Cube'
@MappingRole: true
define role ZEAM_R_MaintNotifCause {
  grant
    select
      on
        ZEAM_R_MaintNotifCause
          where
            inheriting conditions from entity ZEAM_I_MaintNotifCause;
}
