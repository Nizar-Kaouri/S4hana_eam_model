// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Measuring Point - Cube'
@MappingRole: true
define role ZEAM_R_MeasPoint {
  grant
    select
      on
        ZEAM_R_MeasPoint
          where
            inheriting conditions from entity ZEAM_I_MeasPoint;
}
