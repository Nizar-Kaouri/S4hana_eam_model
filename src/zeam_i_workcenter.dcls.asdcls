// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_WorkCenter.
// TODO-VERIFY[H] WC-D01: I_WorkCenter has an access control role and every element it references is projected by ZEAM_I_WorkCenter
@EndUserText.label: 'Work Center'
@MappingRole: true
define role ZEAM_I_WorkCenter {
  grant
    select
      on
        ZEAM_I_WorkCenter
          where
            inheriting conditions from entity I_WorkCenter;
}
