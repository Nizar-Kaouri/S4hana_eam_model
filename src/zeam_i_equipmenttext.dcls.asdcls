// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Equipment descriptions are not treated as authorization-relevant (same approach as
// SAP text views). The role grants unrestricted read access explicitly so that a
// customer can tighten it in one place.
// TODO-VERIFY[M] GEN-D01: unrestricted grant syntax (grant select on <entity>; without where clause)
@EndUserText.label: 'Equipment - Text'
@MappingRole: true
define role ZEAM_I_EquipmentText {
  grant
    select
      on
        ZEAM_I_EquipmentText;
}
