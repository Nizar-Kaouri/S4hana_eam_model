// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Financial conditions (journal entry) AND maintenance order conditions.
// TODO-VERIFY[H] GEN-D03: two AND-combined inheriting conditions in one grant; elements with the same name (CompanyCode, BusinessArea) are shared by both
@EndUserText.label: 'Maintenance Order Cost - Cube'
@MappingRole: true
define role ZEAM_R_MaintOrderCost {
  grant
    select
      on
        ZEAM_R_MaintOrderCost
          where
            ( inheriting conditions from entity ZEAM_I_MaintOrderActualCost ) and
            ( inheriting conditions from entity ZEAM_I_MaintOrder );
}
