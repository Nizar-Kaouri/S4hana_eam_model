// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - order conditions (see GEN-D02).
@EndUserText.label: 'Maintenance Order with Technical Object'
@MappingRole: true
define role ZEAM_R_MaintOrderWithTechObj {
  grant
    select
      on
        ZEAM_R_MaintOrderWithTechObj
          where
            inheriting conditions from entity ZEAM_R_MaintOrder;
}
