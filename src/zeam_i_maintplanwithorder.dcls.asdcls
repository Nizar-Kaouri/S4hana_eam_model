// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - maintenance plan conditions (see GEN-D02).
@EndUserText.label: 'Maintenance Plan with Orders'
@MappingRole: true
define role ZEAM_I_MaintPlanWithOrder {
  grant
    select
      on
        ZEAM_I_MaintPlanWithOrder
          where
            inheriting conditions from entity ZEAM_I_MaintPlan;
}
