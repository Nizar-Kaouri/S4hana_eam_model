// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - functional location conditions (see GEN-D02).
@EndUserText.label: 'Functional Location with Measuring Points'
@MappingRole: true
define role ZEAM_I_FuncLocWithMeasPoint {
  grant
    select
      on
        ZEAM_I_FuncLocWithMeasPoint
          where
            inheriting conditions from entity ZEAM_I_FuncLoc;
}
