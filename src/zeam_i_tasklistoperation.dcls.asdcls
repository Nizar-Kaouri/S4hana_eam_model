// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for the task list operation view.
// TODO-VERIFY[H] TL-D02: the SAP task list operation view has an access control role and every element it references is projected
@EndUserText.label: 'Maintenance Task List Operation'
@MappingRole: true
define role ZEAM_I_TaskListOperation {
  grant
    select
      on
        ZEAM_I_TaskListOperation
          where
            inheriting conditions from entity I_MaintenanceTaskListOperation;
}
