// ZSDV SD VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_DeliveryDocumentItem.
// TODO-VERIFY[H] SD-D04: I_DeliveryDocumentItem has an access control role and every element it references is projected by ZSDV_B_DeliveryItem
@EndUserText.label: 'Outbound Delivery Item'
@MappingRole: true
define role ZSDV_B_DeliveryItem {
  grant
    select
      on
        ZSDV_B_DeliveryItem
          where
            inheriting conditions from entity I_DeliveryDocumentItem;
}
