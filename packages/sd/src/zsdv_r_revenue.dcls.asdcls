// ZSDV SD VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Revenue - Cube'
@MappingRole: true
define role ZSDV_R_Revenue {
  grant
    select
      on
        ZSDV_R_Revenue
          where
            inheriting conditions from entity ZSDV_I_BillingDocumentItem;
}
