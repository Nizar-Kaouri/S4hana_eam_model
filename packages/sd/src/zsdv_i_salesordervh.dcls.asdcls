// ZSDV SD VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Sales Order - Value Help'
@MappingRole: true
define role ZSDV_I_SalesOrderVH {
  grant
    select
      on
        ZSDV_I_SalesOrderVH
          where
            inheriting conditions from entity ZSDV_I_SalesOrder;
}
