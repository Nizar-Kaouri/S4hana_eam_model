// ZSDV SD VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_BillingDocumentItem.
// TODO-VERIFY[H] SD-D06: I_BillingDocumentItem has an access control role and every element it references is projected by ZSDV_I_BillingDocumentItem
@EndUserText.label: 'Billing Document Item'
@MappingRole: true
define role ZSDV_I_BillingDocumentItem {
  grant
    select
      on
        ZSDV_I_BillingDocumentItem
          where
            inheriting conditions from entity I_BillingDocumentItem;
}
