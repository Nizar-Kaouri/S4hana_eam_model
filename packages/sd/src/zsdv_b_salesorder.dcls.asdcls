// ZSDV SD VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_SalesDocument.
// TODO-VERIFY[H] SD-D01: I_SalesDocument has an access control role and every element it references is projected by ZSDV_B_SalesOrder
@EndUserText.label: 'Sales Order'
@MappingRole: true
define role ZSDV_B_SalesOrder {
  grant
    select
      on
        ZSDV_B_SalesOrder
          where
            inheriting conditions from entity I_SalesDocument;
}
