    "production_confirmation": {
      "native_tables": [
        "AFRU"
      ],
      "structures": [
        {
          "view": "ZPPX_C_ConfirmationMig",
          "interface": "ZPPX_I_Confirmation",
          "keys": [
            "ConfirmationNumber",
            "ConfirmationCounter"
          ],
          "mode": "process-reference",
          "fields": [
            "ConfirmationNumber",
            "ConfirmationCounter",
            "ManufacturingOrder",
            "Operation",
            "PostingDate",
            "FinalConfirmation",
            "ReversalFlag",
            "ReversalCounter",
            "YieldQuantity",
            "ScrapQuantity",
            "ConfirmationUnit"
          ]
        }
      ],
      "boundary": "Production confirmations. Preserve confirmation/counter identity and reversal relationships; do not delete reversals and assume the remaining history is net yield. Target order/operation mapping and posting periods must be approved. Reposting confirmations can trigger backflush, goods movements, activity allocations and accounting; confirmation history is reference-only unless a supported process migration explicitly authorizes those effects."
    },
