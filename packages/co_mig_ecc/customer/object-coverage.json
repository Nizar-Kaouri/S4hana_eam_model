    "allocation_cycle": {
      "native_tables": [
        "T811C",
        "T811S"
      ],
      "structures": [
        {
          "view": "ZCOX_C_AllocCycleMig",
          "interface": "ZCOX_I_AllocCycle",
          "keys": [
            "AllocationTable",
            "AllocationCycle",
            "ValidityStartDate"
          ],
          "mode": "configuration-reference",
          "fields": [
            "AllocationTable",
            "AllocationCycle",
            "ValidityStartDate",
            "ValidityEndDate"
          ]
        },
        {
          "view": "ZCOX_C_AllocSegmentMig",
          "interface": "ZCOX_I_AllocSegment",
          "keys": [
            "AllocationTable",
            "AllocationCycle",
            "ValidityStartDate",
            "SegmentSequence"
          ],
          "mode": "configuration-reference",
          "fields": [
            "AllocationTable",
            "AllocationCycle",
            "ValidityStartDate",
            "SegmentSequence",
            "SegmentName"
          ]
        }
      ],
      "boundary": "Allocation cycles and segments. Cycle headers and segments alone are insufficient. Export sender/receiver rules, set membership, tracing factors, accounts, plan/actual context, iterations and company restrictions through the verified native cycle configuration export. T811* table categories and keys vary; use the full-row helper where CDS is unavailable. Do not insert T811* or recreate cycles by posting journal entries; validate and execute a test cycle in the target."
    },
