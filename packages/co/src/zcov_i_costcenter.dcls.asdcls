// ZCOV CO VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_CostCenter.
// TODO-VERIFY[H] CO-D01: I_CostCenter has an access control role and every element it references is projected by ZCOV_I_CostCenter
@EndUserText.label: 'Cost Center'
@MappingRole: true
define role ZCOV_I_CostCenter {
  grant
    select
      on
        ZCOV_I_CostCenter
          where
            inheriting conditions from entity I_CostCenter;
}
