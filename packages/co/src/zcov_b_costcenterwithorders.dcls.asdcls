// ZCOV CO VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Cost Center with Internal Orders'
@MappingRole: true
define role ZCOV_B_CostCenterWithOrders {
  grant
    select
      on
        ZCOV_B_CostCenterWithOrders
          where
            inheriting conditions from entity ZCOV_B_CostCenter;
}
