// ZCOV CO VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Cost Center Costs Year to Date'
@MappingRole: true
define role ZCOV_I_CostCenterYTD {
  grant
    select
      on
        ZCOV_I_CostCenterYTD
          where
            inheriting conditions from entity ZCOV_B_COJournalItem;
}
