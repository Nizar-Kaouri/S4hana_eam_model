// ZCOV CO VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Cost Center - Value Help'
@MappingRole: true
define role ZCOV_B_CostCenterVH {
  grant
    select
      on
        ZCOV_B_CostCenterVH
          where
            inheriting conditions from entity ZCOV_B_CostCenter;
}
