{
  "scope": "Defined native source migration objects; additional target posting interfaces and customer customizing are chosen separately.",
  "modules": {
    "budget": {
      "native_tables": [
        "BPGE",
        "BPJA"
      ],
      "structures": [
        {
          "view": "ZPSX_C_OverallBudgetMig",
          "interface": "ZPSX_I_OverallBudget",
          "keys": [
            "Ledger",
            "ObjectNumber",
            "BudgetItem",
            "TransactionIndicator",
            "ValueType",
            "Version"
          ],
          "mode": "balance",
          "fields": [
            "Ledger",
            "ObjectNumber",
            "BudgetItem",
            "TransactionIndicator",
            "ValueType",
            "Version",
            "OverallBudgetAmount"
          ]
        },
        {
          "view": "ZPSX_C_AnnualBudgetMig",
          "interface": "ZPSX_I_AnnualBudget",
          "keys": [
            "Ledger",
            "ObjectNumber",
            "BudgetItem",
            "TransactionIndicator",
            "ValueType",
            "Version",
            "FiscalYear"
          ],
          "mode": "balance",
          "fields": [
            "Ledger",
            "ObjectNumber",
            "BudgetItem",
            "TransactionIndicator",
            "ValueType",
            "Version",
            "FiscalYear",
            "AnnualBudgetAmount"
          ]
        }
      ],
      "boundary": "Project overall and annual budgets. Separate original budget, supplements, returns, releases and transfers by verified value type and transaction semantics; do not sum all BPGE/BPJA rows as available budget. Currency, object ownership, fiscal year and availability-control settings must be enriched and approved. Reconcile overall and annual budget separately through a supported budget interface."
    },
    "commitment": {
      "native_tables": [
        "COOI"
      ],
      "structures": [
        {
          "view": "ZPSX_C_CommitmentMig",
          "interface": "ZPSX_I_Commitment",
          "keys": [
            "ObjectNumber",
            "FiscalYear",
            "ValueType",
            "Version",
            "CostElement",
            "OriginGroup",
            "BusinessTransaction",
            "CommitmentDocument",
            "CommitmentItem"
          ],
          "mode": "reference",
          "fields": [
            "ObjectNumber",
            "FiscalYear",
            "ValueType",
            "Version",
            "CostElement",
            "OriginGroup",
            "BusinessTransaction",
            "CommitmentDocument",
            "CommitmentItem",
            "TransactionCurrency",
            "TransactionAmount",
            "ObjectCurrencyAmount",
            "ControllingAreaAmount"
          ]
        }
      ],
      "boundary": "Project commitments. COOI grain and fields must be confirmed from DDIC before extraction. Tie commitments to approved PR/PO items and their remaining obligations. Commitments are generally regenerated from migrated purchasing documents: never post both a commitment history and its purchasing source. Enrich object and controlling-area currencies before monetary checks."
    },
    "investment_measure": {
      "native_tables": [
        "IMPR",
        "IMTP",
        "IMZO"
      ],
      "structures": [
        {
          "view": "ZPSX_C_InvestProgramMig",
          "interface": "ZPSX_I_InvestProgram",
          "keys": [
            "InvestmentProgram",
            "ApprovalFiscalYear"
          ],
          "mode": "configuration-reference",
          "fields": [
            "InvestmentProgram",
            "ApprovalFiscalYear",
            "InvestmentProgramDescription"
          ]
        },
        {
          "view": "ZPSX_C_InvestPositionMig",
          "interface": "ZPSX_I_InvestPosition",
          "keys": [
            "InvestmentPositionInternalID"
          ],
          "mode": "configuration-reference",
          "fields": [
            "InvestmentPositionInternalID",
            "InvestmentProgram",
            "ApprovalFiscalYear",
            "InvestmentPosition",
            "ObjectNumber"
          ]
        },
        {
          "view": "ZPSX_C_InvestAssignMig",
          "interface": "ZPSX_I_InvestAssign",
          "keys": [
            "InvestmentPositionInternalID",
            "AssignedObject",
            "ApprovalFiscalYear"
          ],
          "mode": "configuration-reference",
          "fields": [
            "InvestmentPositionInternalID",
            "AssignedObject",
            "ApprovalFiscalYear",
            "AssignmentPercentage"
          ]
        }
      ],
      "boundary": "Investment programs and measures. Verify investment-program hierarchy and annual approval, assignments to WBS/internal orders, investment profiles, budget distribution and asset-under-construction settlement. IMTP/IMPR/IMZO are candidate configuration/reference structures, not a finished investment-measure posting schema. Preserve externally meaningful identifiers and map internal object numbers."
    },
