// ZMMV MM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Purchase Order - Value Help'
@MappingRole: true
define role ZMMV_B_PurchaseOrderVH {
  grant
    select
      on
        ZMMV_B_PurchaseOrderVH
          where
            inheriting conditions from entity ZMMV_B_PurchaseOrder;
}
