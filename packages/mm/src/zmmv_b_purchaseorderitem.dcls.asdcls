// ZMMV MM VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_PurchaseOrderItemAPI01.
// TODO-VERIFY[H] MM-D07: I_PurchaseOrderItemAPI01 has an access control role and every element it references is projected by ZMMV_B_PurchaseOrderItem
@EndUserText.label: 'Purchase Order Item'
@MappingRole: true
define role ZMMV_B_PurchaseOrderItem {
  grant
    select
      on
        ZMMV_B_PurchaseOrderItem
          where
            inheriting conditions from entity I_PurchaseOrderItemAPI01;
}
