// ZMMV MM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Goods Movement - Cube'
@MappingRole: true
define role ZMMV_I_GoodsMovement {
  grant
    select
      on
        ZMMV_I_GoodsMovement
          where
            inheriting conditions from entity ZMMV_B_GoodsMovement;
}
