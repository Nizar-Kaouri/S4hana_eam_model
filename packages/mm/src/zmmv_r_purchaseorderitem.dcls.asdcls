@EndUserText.label: 'Purchase Order Item - Cube'
@MappingRole: true
define role ZMMV_R_PurchaseOrderItem {
  grant
    select
      on
        ZMMV_R_PurchaseOrderItem
          where
            inheriting conditions from entity ZMMV_I_PurchaseOrderItem;
}
