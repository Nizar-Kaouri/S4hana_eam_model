// ZMMV MM VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_Product.
// TODO-VERIFY[H] MM-D01: I_Product has an access control role and every element it references is projected by ZMMV_B_Product
@EndUserText.label: 'Product'
@MappingRole: true
define role ZMMV_B_Product {
  grant
    select
      on
        ZMMV_B_Product
          where
            inheriting conditions from entity I_Product;
}
