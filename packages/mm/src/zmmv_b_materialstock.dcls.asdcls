// ZMMV MM VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_MaterialStock_2.
// TODO-VERIFY[H] MM-D03: I_MaterialStock_2 has an access control role and every element it references is projected by ZMMV_B_MaterialStock
@EndUserText.label: 'Material Stock'
@MappingRole: true
define role ZMMV_B_MaterialStock {
  grant
    select
      on
        ZMMV_B_MaterialStock
          where
            inheriting conditions from entity I_MaterialStock_2;
}
