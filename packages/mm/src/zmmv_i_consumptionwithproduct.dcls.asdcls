// ZMMV MM VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Material Consumption with Product'
@MappingRole: true
define role ZMMV_I_ConsumptionWithProduct {
  grant
    select
      on
        ZMMV_I_ConsumptionWithProduct
          where
            inheriting conditions from entity ZMMV_I_MaterialConsumption;
}
