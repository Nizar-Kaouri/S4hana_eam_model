// ZMMV MM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Product - Value Help'
@MappingRole: true
define role ZMMV_B_ProductVH {
  grant
    select
      on
        ZMMV_B_ProductVH
          where
            inheriting conditions from entity ZMMV_B_Product;
}
