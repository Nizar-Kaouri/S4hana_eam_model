// ZPSV PS VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the journal conditions.
// TODO-VERIFY[H] PS-D04: the aggregated view keeps only company code, WBS element, ledger and currency; if the inherited journal role uses other elements the role fails
@EndUserText.label: 'Project Cost to Date'
@MappingRole: true
define role ZPSV_R_ProjectCostToDate {
  grant
    select
      on
        ZPSV_R_ProjectCostToDate
          where
            inheriting conditions from entity ZPSV_I_ProjectJournalItem;
}
