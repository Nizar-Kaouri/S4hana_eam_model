// ZPSV PS VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Project - Cube'
@MappingRole: true
define role ZPSV_I_Project {
  grant
    select
      on
        ZPSV_I_Project
          where
            inheriting conditions from entity ZPSV_B_Project;
}
