@EndUserText.label: 'Project Cost with Project Master'
@MappingRole: true
define role ZPSV_R_ProjectCostWithMaster {
  grant
    select
      on
        ZPSV_R_ProjectCostWithMaster
          where
            inheriting conditions from entity ZPSV_R_ProjectCost;
}
