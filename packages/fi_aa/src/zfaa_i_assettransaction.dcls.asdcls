// ZFAA FI-AA VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Asset Transaction - Cube'
@MappingRole: true
define role ZFAA_I_AssetTransaction {
  grant
    select
      on
        ZFAA_I_AssetTransaction
          where
            inheriting conditions from entity ZFAA_B_AssetJournalItem;
}
