// ZBRG Bridge VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Purchase Order Item with Supplier'
@MappingRole: true
define role ZBRG_I_POItemWithSupplier {
  grant
    select
      on
        ZBRG_I_POItemWithSupplier
          where
            inheriting conditions from entity ZMMV_I_PurchaseOrderItem;
}
