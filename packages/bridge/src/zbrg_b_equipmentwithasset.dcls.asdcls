// ZBRG Bridge VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Equipment with Fixed Asset'
@MappingRole: true
define role ZBRG_B_EquipmentWithAsset {
  grant
    select
      on
        ZBRG_B_EquipmentWithAsset
          where
            inheriting conditions from entity ZEAM_B_Equipment;
}
