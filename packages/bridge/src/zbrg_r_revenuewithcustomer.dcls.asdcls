// ZBRG Bridge VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Revenue with Customer'
@MappingRole: true
define role ZBRG_R_RevenueWithCustomer {
  grant
    select
      on
        ZBRG_R_RevenueWithCustomer
          where
            inheriting conditions from entity ZSDV_R_Revenue;
}
