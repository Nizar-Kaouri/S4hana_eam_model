@EndUserText.label: 'Production Operation with Work Center'
@MappingRole: true
define role ZBRG_B_ProdOpWithWorkCenter {
  grant
    select
      on
        ZBRG_B_ProdOpWithWorkCenter
          where
            inheriting conditions from entity ZPPV_B_ProductionOrderOp;
}
