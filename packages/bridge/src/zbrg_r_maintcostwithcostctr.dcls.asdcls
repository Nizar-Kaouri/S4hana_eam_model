// ZBRG Bridge VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Maintenance Cost with Cost Center'
@MappingRole: true
define role ZBRG_R_MaintCostWithCostCtr {
  grant
    select
      on
        ZBRG_R_MaintCostWithCostCtr
          where
            inheriting conditions from entity ZEAM_R_MaintOrderCost;
}
