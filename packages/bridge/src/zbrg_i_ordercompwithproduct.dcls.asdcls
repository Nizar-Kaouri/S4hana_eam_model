// ZBRG Bridge VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Order Component with Product'
@MappingRole: true
define role ZBRG_I_OrderCompWithProduct {
  grant
    select
      on
        ZBRG_I_OrderCompWithProduct
          where
            inheriting conditions from entity ZEAM_I_MaintOrderComponent;
}
