// ZBRG Bridge VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Maintenance Order with Goods Movements'
@MappingRole: true
define role ZBRG_I_MaintOrderWithGoodsMvt {
  grant
    select
      on
        ZBRG_I_MaintOrderWithGoodsMvt
          where
            inheriting conditions from entity ZEAM_I_MaintOrder;
}
