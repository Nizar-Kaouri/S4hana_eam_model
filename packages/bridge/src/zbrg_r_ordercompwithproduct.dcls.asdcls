// ZBRG Bridge VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Order Component Cube with Product'
@MappingRole: true
define role ZBRG_R_OrderCompWithProduct {
  grant
    select
      on
        ZBRG_R_OrderCompWithProduct
          where
            inheriting conditions from entity ZEAM_R_MaintOrderComponent;
}
