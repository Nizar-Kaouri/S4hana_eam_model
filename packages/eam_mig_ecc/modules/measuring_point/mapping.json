{
  "module": "measuring_point",
  "status": "released",
  "target": {
    "tool": "customer load program (reads the consumption views, posts on S/4HANA)",
    "compatibility_notes": [
      "Compatibility note: target fields are the S/4HANA table fields, assumed unchanged from ECC for Plant Maintenance; confirm them against the posting interface (BAPI / API) the load program uses"
    ]
  },
  "sequence_after": [
    "equipment",
    "functional_location"
  ],
  "key": {
    "business_key": [
      "MeasuringPoint"
    ],
    "numbering": "new",
    "note": "Measuring point numbers are usually assigned internally on S/4HANA: the load program keeps the old -> new numbers for the objects loaded later."
  },
  "structures": [
    {
      "consumption_view": "ZEMX_C_MeasuringPointMig",
      "source_view": "ZEMX_I_MeasuringPoint",
      "scope_filter": "src.IsMarkedForDeletion = ''",
      "keys": [
        "MeasuringPoint"
      ],
      "fields": [
        {
          "element": "MeasuringPoint",
          "source": "IMPTT-POINT",
          "target": "IMPTT-POINT",
          "rule": "copy"
        },
        {
          "element": "MeasuringPointDescription",
          "source": "IMPTT-PTTXT",
          "target": "IMPTT-PTTXT",
          "rule": "copy"
        },
        {
          "element": "MeasuringPointCategory",
          "source": "IMPTT-MPTYP",
          "target": "IMPTT-MPTYP",
          "rule": "copy"
        },
        {
          "element": "MeasuringPointPositionNumber",
          "source": "IMPTT-PSORT",
          "target": "IMPTT-PSORT",
          "rule": "copy"
        },
        {
          "element": "MeasuringPointObjectType",
          "source": "IMPTT: substring( imptt.mpobj, 1, 2 )",
          "target": "",
          "rule": "derive:IE = equipment, IF = functional location"
        },
        {
          "element": "TechnicalObjectKey",
          "source": "IMPTT: substring( imptt.mpobj, 3, 30 )",
          "target": "",
          "rule": "copy"
        },
        {
          "element": "Characteristic",
          "source": "CABN-ATNAM",
          "target": "CABN-ATNAM",
          "rule": "copy"
        },
        {
          "element": "MeasuringPointIsCounter",
          "source": "IMPTT-INDCT",
          "target": "IMPTT-INDCT",
          "rule": "copy"
        },
        {
          "element": "MeasuringPointDecimalPlaces",
          "source": "IMPTT-DECIM",
          "target": "IMPTT-DECIM",
          "rule": "copy"
        },
        {
          "element": "MeasurementRangeUnit",
          "source": "IMPTT-MRNGU",
          "target": "IMPTT-MRNGU",
          "rule": "copy"
        },
        {
          "element": "LowerRangeLimit",
          "source": "IMPTT-MRMIN",
          "target": "IMPTT-MRMIN",
          "rule": "convert:float_si_to_unit"
        },
        {
          "element": "UpperRangeLimit",
          "source": "IMPTT-MRMAX",
          "target": "IMPTT-MRMAX",
          "rule": "convert:float_si_to_unit"
        },
        {
          "element": "TargetValue",
          "source": "IMPTT-DESIR",
          "target": "IMPTT-DESIR",
          "rule": "convert:float_si_to_unit"
        },
        {
          "element": "CodeGroup",
          "source": "IMPTT-CODGR",
          "target": "IMPTT-CODGR",
          "rule": "copy"
        },
        {
          "element": "MeasuringPointIsInactive",
          "source": "IMPTT-INACT",
          "target": "IMPTT-INACT",
          "rule": "copy"
        },
        {
          "element": "AuthorizationGroup",
          "source": "IMPTT-BEGRU",
          "target": "IMPTT-BEGRU",
          "rule": "copy"
        },
        {
          "element": "LastChangeDate",
          "source": "IMPTT-AEDAT",
          "target": "",
          "rule": "info"
        }
      ]
    },
    {
      "consumption_view": "ZEMX_C_MeasPointLongTextMig",
      "source_view": "ZEMX_I_MeasPointLongText",
      "scope_filter": "",
      "keys": [
        "TextObject",
        "TextName",
        "TextID",
        "Language"
      ],
      "fields": [
        {
          "element": "TextObject",
          "source": "STXH-TDOBJECT",
          "target": "",
          "rule": "copy"
        },
        {
          "element": "TextName",
          "source": "STXH-TDNAME",
          "target": "",
          "rule": "copy"
        },
        {
          "element": "TextID",
          "source": "STXH-TDID",
          "target": "",
          "rule": "copy"
        },
        {
          "element": "Language",
          "source": "STXH-TDSPRAS",
          "target": "",
          "rule": "copy"
        }
      ],
      "delivery_mode": "reference",
      "preprocessing": "SAPscript index only. Populate the explicit full text-key to business-owner link file from the source text editor/application metadata, run the text_scope preparation step against selected masters, then READ_TEXT to retrieve ordered formatted lines. Never infer the business owner from a TDNAME substring or post compressed STXL data."
    }
  ],
  "not_migrated": [
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "MeasuringPointObjectNumber",
      "source": "IMPTT-MPOBJ",
      "reason": "skip:rebuilt from the technical object key on S/4HANA"
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "CharcInternalID",
      "source": "IMPTT-ATINN",
      "reason": "skip:internal characteristic number - mapped by name"
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "IsMarkedForDeletion",
      "source": "IMPTT-LVORM",
      "reason": "scope"
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "CreationDate",
      "source": "IMPTT-ERDAT",
      "reason": "info"
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "CreatedByUser",
      "source": "IMPTT-ERNAM",
      "reason": "info"
    }
  ],
  "gaps": [
    "Compatibility note: characteristics (CABN) must exist on S/4HANA with the same name and unit before the load"
  ],
  "main_structure": "ZEMX_C_MeasuringPointMig",
  "source_control": {
    "source_count_view": "ZEMX_C_MeasPointMigCount",
    "dimensions": [
      {
        "element": "MeasuringPointCategory"
      },
      {
        "element": "MeasuringPointIsCounter"
      }
    ],
    "measure": "RecordCount"
  }
}
