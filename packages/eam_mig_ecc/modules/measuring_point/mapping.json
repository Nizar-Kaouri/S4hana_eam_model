{
  "module": "measuring_point",
  "status": "draft-unverified",
  "target": {
    "tool": "SAP S/4HANA Migration Cockpit",
    "migration_object": "Measuring point",
    "todo_verify": [
      "TODO-VERIFY[H] XMP-M01: Migration Cockpit object for 'Measuring point' (name, approach staging tables / direct transfer) and its structure field names; targets below are the S/4HANA table fields, assumed unchanged from ECC for Plant Maintenance"
    ]
  },
  "sequence_after": [
    "equipment",
    "functional_location"
  ],
  "key": {
    "business_key": [
      "MeasuringPoint"
    ],
    "numbering": "new",
    "note": "Measuring point numbers are usually assigned internally on S/4HANA: keep the key map 'measuring_point' (old,new) from the load log; maintenance plan cycles and measurement documents use it."
  },
  "scope": {
    "filter": "IsMarkedForDeletion = ''",
    "note": "Measuring points flagged for deletion are not migrated."
  },
  "fields": [
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "MeasuringPoint",
      "source": "IMPTT-POINT",
      "target": "IMPTT-POINT",
      "rule": "key_map:measuring_point",
      "compare": true
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "MeasuringPointDescription",
      "source": "IMPTT-PTTXT",
      "target": "IMPTT-PTTXT",
      "rule": "copy",
      "compare": false
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "MeasuringPointCategory",
      "source": "IMPTT-MPTYP",
      "target": "IMPTT-MPTYP",
      "rule": "value_map:measuring_point_category",
      "compare": true
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "MeasuringPointPositionNumber",
      "source": "IMPTT-PSORT",
      "target": "IMPTT-PSORT",
      "rule": "copy",
      "compare": false
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "MeasuringPointObjectType",
      "source": "substring( imptt.mpobj, 1, 2 )",
      "target": "",
      "rule": "derive:IE = equipment, IF = functional location",
      "compare": false
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "TechnicalObjectKey",
      "source": "substring( imptt.mpobj, 3, 30 )",
      "target": "IMPTT-MPOBJ (rebuilt from the new key)",
      "rule": "key_map:equipment|functional_location",
      "compare": false
    },
    {
      "view": "ZEMX_I_MeasuringPoint",
      "element": "Characteristic",
      "source": "CABN-ATNAM",
