        },
        {
          "element": "StatusObjectKey",
          "source": "JEST: substring( jest.objnr, 3, 30 )",
          "target": "",
          "rule": "key_map:equipment|functional_location|maintenance_notification|maintenance_order",
          "compare": false
        },
        {
          "element": "StatusProfile",
          "source": "JSTO-STSMA",
          "target": "JSTO-STSMA",
          "rule": "value_map:status_profile",
          "compare": false
        }
      ]
    }
  ],
  "not_migrated": [
    {
      "view": "ZEMX_I_ObjectStatus",
      "element": "ObjectNumber",
      "source": "JEST-OBJNR",
      "reason": "skip:rebuilt on S/4HANA from the translated object key"
    },
    {
      "view": "ZEMX_I_ObjectStatus",
      "element": "StatusKind",
