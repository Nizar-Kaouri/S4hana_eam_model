// ZQMV QM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Quality Notification - Cube'
@MappingRole: true
define role ZQMV_I_QualityNotif {
  grant
    select
      on
        ZQMV_I_QualityNotif
          where
            inheriting conditions from entity ZQMV_B_QualityNotif;
}
