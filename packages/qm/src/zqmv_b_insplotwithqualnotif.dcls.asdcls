// ZQMV QM VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Inspection Lot with Quality Notifications'
@MappingRole: true
define role ZQMV_B_InspLotWithQualNotif {
  grant
    select
      on
        ZQMV_B_InspLotWithQualNotif
          where
            inheriting conditions from entity ZQMV_B_InspectionLot;
}
