// ZPPV PP VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Production Order Operation - Cube'
@MappingRole: true
define role ZPPV_I_ProductionOrderOp {
  grant
    select
      on
        ZPPV_I_ProductionOrderOp
          where
            inheriting conditions from entity ZPPV_B_ProductionOrderOp;
}
