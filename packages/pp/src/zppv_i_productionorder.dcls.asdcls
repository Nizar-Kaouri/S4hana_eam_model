// ZPPV PP VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_ManufacturingOrder.
// TODO-VERIFY[H] PP-D01: I_ManufacturingOrder has an access control role and every element it references is projected by ZPPV_I_ProductionOrder
@EndUserText.label: 'Production Order'
@MappingRole: true
define role ZPPV_I_ProductionOrder {
  grant
    select
      on
        ZPPV_I_ProductionOrder
          where
            inheriting conditions from entity I_ManufacturingOrder;
}
