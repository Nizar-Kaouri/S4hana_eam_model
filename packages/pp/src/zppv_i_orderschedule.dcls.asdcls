// ZPPV PP VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Production Order Schedule Adherence'
@MappingRole: true
define role ZPPV_I_OrderSchedule {
  grant
    select
      on
        ZPPV_I_OrderSchedule
          where
            inheriting conditions from entity ZPPV_B_ProductionOrder;
}
