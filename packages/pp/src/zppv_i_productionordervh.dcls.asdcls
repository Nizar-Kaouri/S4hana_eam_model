// ZPPV PP VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Production Order - Value Help'
@MappingRole: true
define role ZPPV_I_ProductionOrderVH {
  grant
    select
      on
        ZPPV_I_ProductionOrderVH
          where
            inheriting conditions from entity ZPPV_I_ProductionOrder;
}
