// ZPPV PP VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Bill of Material Item - Cube'
@MappingRole: true
define role ZPPV_R_BOMItem {
  grant
    select
      on
        ZPPV_R_BOMItem
          where
            inheriting conditions from entity ZPPV_I_BOMItem;
}
