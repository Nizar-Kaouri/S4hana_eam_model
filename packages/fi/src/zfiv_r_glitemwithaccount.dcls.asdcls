// ZFIV FI VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'G/L Line Item with G/L Account'
@MappingRole: true
define role ZFIV_R_GLItemWithAccount {
  grant
    select
      on
        ZFIV_R_GLItemWithAccount
          where
            inheriting conditions from entity ZFIV_R_GLJournalItem;
}
