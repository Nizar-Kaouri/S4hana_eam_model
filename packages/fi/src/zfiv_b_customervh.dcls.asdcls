// ZFIV FI VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of its data source (see GEN-D02).
@EndUserText.label: 'Customer - Value Help'
@MappingRole: true
define role ZFIV_B_CustomerVH {
  grant
    select
      on
        ZFIV_B_CustomerVH
          where
            inheriting conditions from entity ZFIV_B_Customer;
}
