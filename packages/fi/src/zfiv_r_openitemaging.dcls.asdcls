@EndUserText.label: 'Open Item Aging - Cube'
@MappingRole: true
define role ZFIV_R_OpenItemAging {
  grant
    select
      on
        ZFIV_R_OpenItemAging
          where
            inheriting conditions from entity ZFIV_I_OpenItem;
}
