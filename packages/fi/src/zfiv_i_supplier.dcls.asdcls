// ZFIV FI VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_Supplier.
// TODO-VERIFY[H] FI-D03: I_Supplier has an access control role and every element it references is projected by ZFIV_I_Supplier
@EndUserText.label: 'Supplier'
@MappingRole: true
define role ZFIV_I_Supplier {
  grant
    select
      on
        ZFIV_I_Supplier
          where
            inheriting conditions from entity I_Supplier;
}
