// ZFIV FI VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - conditions of the data source (see GEN-D02).
@EndUserText.label: 'Open Items with Supplier'
@MappingRole: true
define role ZFIV_R_OpenItemWithSupplier {
  grant
    select
      on
        ZFIV_R_OpenItemWithSupplier
          where
            inheriting conditions from entity ZFIV_R_OpenItemAging;
}
