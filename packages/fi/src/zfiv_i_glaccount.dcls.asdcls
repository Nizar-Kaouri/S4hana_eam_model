// ZFIV FI VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_GLAccountInChartOfAccounts.
// TODO-VERIFY[H] FI-D01: I_GLAccountInChartOfAccounts has an access control role and every element it references is projected by ZFIV_I_GLAccount
@EndUserText.label: 'G/L Account'
@MappingRole: true
define role ZFIV_I_GLAccount {
  grant
    select
      on
        ZFIV_I_GLAccount
          where
            inheriting conditions from entity I_GLAccountInChartOfAccounts;
}
