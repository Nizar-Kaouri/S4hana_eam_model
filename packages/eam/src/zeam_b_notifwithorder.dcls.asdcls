// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - notification conditions (see GEN-D02).
@EndUserText.label: 'Notification with Maintenance Order'
@MappingRole: true
define role ZEAM_B_NotifWithOrder {
  grant
    select
      on
        ZEAM_B_NotifWithOrder
          where
            inheriting conditions from entity ZEAM_B_MaintNotif;
}
