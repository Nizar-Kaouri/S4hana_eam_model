// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the operation conditions (see GEN-D02).
@EndUserText.label: 'Maintenance Backlog - Cube'
@MappingRole: true
define role ZEAM_I_MaintBacklog {
  grant
    select
      on
        ZEAM_I_MaintBacklog
          where
            inheriting conditions from entity ZEAM_B_MaintOrderOperation;
}
