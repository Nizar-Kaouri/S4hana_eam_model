// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - functional location conditions (see GEN-D02).
@EndUserText.label: 'Functional Location with Maintenance Orders'
@MappingRole: true
define role ZEAM_B_FuncLocWithOrder {
  grant
    select
      on
        ZEAM_B_FuncLocWithOrder
          where
            inheriting conditions from entity ZEAM_B_FuncLoc;
}
