// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_MaintenanceItem.
// TODO-VERIFY[H] PL-D02: I_MaintenanceItem has an access control role and every element it references is projected by ZEAM_B_MaintItem
@EndUserText.label: 'Maintenance Item'
@MappingRole: true
define role ZEAM_B_MaintItem {
  grant
    select
      on
        ZEAM_B_MaintItem
          where
            inheriting conditions from entity I_MaintenanceItem;
}
