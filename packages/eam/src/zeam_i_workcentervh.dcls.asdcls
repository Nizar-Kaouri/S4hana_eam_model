// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Work Center - Value Help'
@MappingRole: true
define role ZEAM_I_WorkCenterVH {
  grant
    select
      on
        ZEAM_I_WorkCenterVH
          where
            inheriting conditions from entity ZEAM_I_WorkCenter;
}
