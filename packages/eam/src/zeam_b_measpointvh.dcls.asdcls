// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Measuring Point - Value Help'
@MappingRole: true
define role ZEAM_B_MeasPointVH {
  grant
    select
      on
        ZEAM_B_MeasPointVH
          where
            inheriting conditions from entity ZEAM_B_MeasPoint;
}
