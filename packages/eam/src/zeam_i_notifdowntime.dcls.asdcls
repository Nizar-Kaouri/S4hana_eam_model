// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the downtime basic view (see GEN-D02).
@EndUserText.label: 'Downtime and Breakdown - Cube'
@MappingRole: true
define role ZEAM_I_NotifDowntime {
  grant
    select
      on
        ZEAM_I_NotifDowntime
          where
            inheriting conditions from entity ZEAM_B_NotifDowntime;
}
