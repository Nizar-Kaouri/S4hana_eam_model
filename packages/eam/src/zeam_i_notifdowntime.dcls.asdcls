// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the notification conditions (see GEN-D02).
@EndUserText.label: 'Notification Downtime'
@MappingRole: true
define role ZEAM_I_NotifDowntime {
  grant
    select
      on
        ZEAM_I_NotifDowntime
          where
            inheriting conditions from entity ZEAM_I_MaintNotif;
}
