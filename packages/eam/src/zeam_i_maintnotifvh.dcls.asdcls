// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Maintenance Notification - Value Help'
@MappingRole: true
define role ZEAM_I_MaintNotifVH {
  grant
    select
      on
        ZEAM_I_MaintNotifVH
          where
            inheriting conditions from entity ZEAM_I_MaintNotif;
}
