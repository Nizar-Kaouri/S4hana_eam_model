// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Maintenance Order Operation - Cube'
@MappingRole: true
define role ZEAM_I_MaintOrderOperation {
  grant
    select
      on
        ZEAM_I_MaintOrderOperation
