// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// LINK VIEW role - notification conditions (see GEN-D02).
@EndUserText.label: 'Downtime with Technical Object'
@MappingRole: true
define role ZEAM_I_DowntimeWithTechObj {
  grant
    select
      on
        ZEAM_I_DowntimeWithTechObj
          where
            inheriting conditions from entity ZEAM_I_NotifDowntime;
}
