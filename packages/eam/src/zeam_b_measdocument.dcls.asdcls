// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_MeasurementDocument.
// TODO-VERIFY[H] MD-D01: I_MeasurementDocument has an access control role and every element it references is projected by ZEAM_B_MeasDocument
@EndUserText.label: 'Measurement Document'
@MappingRole: true
define role ZEAM_B_MeasDocument {
  grant
    select
      on
        ZEAM_B_MeasDocument
          where
            inheriting conditions from entity I_MeasurementDocument;
}
