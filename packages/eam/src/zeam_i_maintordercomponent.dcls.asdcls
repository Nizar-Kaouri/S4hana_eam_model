// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Maintenance Order Component - Cube'
@MappingRole: true
define role ZEAM_I_MaintOrderComponent {
  grant
    select
      on
        ZEAM_I_MaintOrderComponent
          where
            inheriting conditions from entity ZEAM_B_MaintOrderComponent;
}
