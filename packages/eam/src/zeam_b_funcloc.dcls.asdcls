// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Reuses the authorization logic SAP ships for I_FunctionalLocation. All elements
// referenced by the SAP role must exist in ZEAM_B_FuncLoc with identical names.
// TODO-VERIFY[H] FL-D01: I_FunctionalLocation has an access control role and all elements it references are projected by ZEAM_B_FuncLoc
@EndUserText.label: 'Functional Location'
@MappingRole: true
define role ZEAM_B_FuncLoc {
  grant
    select
      on
        ZEAM_B_FuncLoc
          where
            inheriting conditions from entity I_FunctionalLocation;
}
