// ZEAM EAM/PM VDM - status: draft-unverified (no SAP system available, never activated)
// Inherits the conditions of the basic view (see GEN-D02).
@EndUserText.label: 'Measurement Document - Cube'
@MappingRole: true
define role ZEAM_I_MeasDocument {
  grant
    select
      on
        ZEAM_I_MeasDocument
          where
            inheriting conditions from entity ZEAM_B_MeasDocument;
}
