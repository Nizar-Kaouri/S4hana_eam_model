{
  "ewm": {
    "prefix": "WM",
    "title": "Extended Warehouse Management",
    "title_de": "Erweiterte Lagerverwaltung",
    "landscape": "ECC LE-WM or Business Suite/decentralized/embedded EWM; record which native export produced each cohort.",
    "risk": "LE-WM and EWM are distinct source models. Warehouse numbers, entitled-to-dispose party, owner, stock type, batch, HU and serial identities require mapping. Freeze inventory and reconcile MM/IM and EWM without loading stock twice. Open warehouse tasks, orders and deliveries require a verified process migration; recreate or complete them through supported business operations, not table inserts. Packaging specifications and storage-type customizing must be validated independently.",
    "risk_de": "LE-WM und EWM besitzen unterschiedliche Quellmodelle. Lagernummer, Verfügungsberechtigter, Eigentümer, Bestandsart, Charge, HU und Seriennummern zuordnen. Bestände einfrieren und MM/IM mit EWM ohne Doppelbeladung abstimmen. Offene Lageraufgaben, Lageraufträge und Lieferungen benötigen freigegebene Geschäftsprozesse. Packvorschriften und Lagertyp-Customizing separat prüfen.",
    "modules": [
      {
        "name": "storage_bin",
        "title": "Storage bins and sorting",
        "structures": [
          {
            "stem": "StorageBin",
            "keys": [
              "Warehouse",
              "StorageBin"
            ],
            "fields": [
              "StorageType",
              "StorageSection",
              "BinType",
              "Capacity",
              "CapacityUnit",
              "Blocked"
            ]
          },
          {
            "stem": "BinSorting",
            "keys": [
              "Warehouse",
              "StorageBin",
              "SortSequence"
            ],
            "fields": [
              "ActivityArea",
              "Activity",
              "SortDirection"
            ]
          }
        ],
        "deps": [],
        "mode": "master"
      },
      {
        "name": "warehouse_product",
        "title": "Warehouse products and fixed bins",
        "structures": [
          {
            "stem": "WarehouseProd",
            "keys": [
              "Warehouse",
              "Product",
              "EntitledParty"
            ],
            "fields": [
              "WarehouseUoM",
              "PutawayControl",
              "RemovalControl",
              "CycleCountIndicator"
            ]
          },
          {
            "stem": "FixedBin",
            "keys": [
              "Warehouse",
